<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing SDK-specific is declared here beyond the deep-link intent filter — the SDK's
    own manifest entries (INTERNET, WorkManager's permissions, the install-referrer
    <queries> entry) are merged in automatically from the .aar. See docs/privacy.md for the
    full list and why each one is there.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ExampleApp"
        android:allowBackup="false"
        android:label="Colada SDK Example"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
            singleTask so a deep link that arrives while the app is already running is
            delivered to THIS instance via onNewIntent, instead of stacking a second copy of
            the Activity — see MainActivity.onNewIntent and docs/deep-links.md.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Custom-scheme deep link — works everywhere, no server-side setup. This is
                the filter the SDK needs to see the links that open your app; see
                docs/deep-links.md for how to add an https App Link on top of this.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coladaexample" />
            </intent-filter>
        </activity>

    </application>

</manifest>
