<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colada SDK Example"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/userIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="user id (e.g. demo-user-1)" />

        <Button
            android:id="@+id/setUserButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="setUser" />

        <Button
            android:id="@+id/clearUserButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="clearUser" />

        <Button
            android:id="@+id/trackViewContentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="track(ViewContent)" />

        <Button
            android:id="@+id/trackPurchaseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="track(Purchase 49.99 USD)" />

        <Button
            android:id="@+id/flushButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="flush()" />

        <Button
            android:id="@+id/deviceIdButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="show deviceId" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Console"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
